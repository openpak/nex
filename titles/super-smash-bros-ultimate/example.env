# super-smash-bros-ultimate — example configuration. Copy to .env and fill in. Never commit a
# real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22350: authentication 22350, secure 22351, /healthz 22352. Two listeners.
NEX_PORT_BASE=22350

# SSBU's NEX access key. Not a secret — it is a per-title constant that comes out of the game's
# own binary — but it is configuration, so it lives here and never in source. Confirmed by two
# sources: Kinnay's Game Server List and the ExternalReference SSBU server, which agree on it.
NEX_ACCESS_KEY=9587602b

# NEX library version. UNVERIFIED: the ExternalReference server sets 4.0.0 (40000) but in a file
# templated from Mario Kart 8 Deluxe, so treat this as a guess until a capture reports the
# console's apiVersionGeneral. Accepts "4.0.0" or the integer form 40000. See docs/provenance.md.
NEX_VERSION=4.0.0

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# Transport and stream IDs are servers/nex defaults now, and both defaults are right for SSBU:
# websocket transport, and NEX_SECURE_STREAM_ID=1, which is the two-listener shape -- auth on
# 22350, secure on its own dialable 22351. That is what SSBU's ExternalReference server does
# (:443 auth, separate secure port) and it matches the sid=1 in the station URL it hands out.
# Do NOT set NEX_SECURE_STREAM_ID=2 here; that is the single-listener shape.

# prudps, from SSBU's station URL. Getting it wrong is not a clean failure: menus keep working
# and the title gives up later, when it actually needs the session. This is the servers/nex
# default, so it is left unset.

# Source key length. SSBU's ExternalReference server records that the key MUST be 32 bytes or the
# console rejects the ticket; 32 is the servers/nex default, so it is left unset.

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# Matchmaking, NEX unique IDs (Utility) and DataStore metadata all live here. The libraries
# create their own schemas (matchmaking, tracking, utility) and this repository creates ssbu.
SSBU_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable

# --- DataStore object bodies (optional) ---
# Leave SSBU_S3_ENDPOINT empty and DataStore still serves every metadata call; only the three
# that move an object body answer Core::NotImplemented. Set it and all four do.
SSBU_S3_ENDPOINT=
SSBU_S3_BUCKET=super-smash-bros-ultimate
SSBU_S3_ACCESS_KEY=
SSBU_S3_SECRET_KEY=
# 1 for a plain-HTTP store, e.g. a local MinIO.
SSBU_S3_INSECURE=0
