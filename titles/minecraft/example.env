# minecraft — example configuration. Copy to .env and fill in. Never commit a real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22310: authentication 22310, secure 22311, /healthz 22312. Two listeners.
NEX_PORT_BASE=22310

# Minecraft's NEX access key. Not a secret — it is a per-title constant that comes out of the
# game's own binary — but it is configuration, so it lives here and never in source. This
# value was verified cryptographically against a measured CONNECT signature; see provenance.md.
NEX_ACCESS_KEY=f4983d87

# The NEX library version, integer form (major*10000 + minor*100 + patch). The working
# ExternalReference server runs Minecraft at 40000 (4.0.0). A source comment there instead calls
# it 4.3.1 — an unresolved contradiction (see provenance.md); both are >= 4.0.0, so byte-stream
# shape and login-method routing are identical either way. A login capture settles it.
NEX_VERSION=40000

# Per-title: Minecraft's working server advertises the secure station URL with the *prudp*
# scheme, NOT prudps. This differs from most fleet titles (ARMS uses prudps) and is the top
# thing to verify on hardware — the wrong scheme is a silent later failure (menus work, the
# title gives up when Pia needs the session). See provenance.md and design.md.
NEX_STATION_SCHEME=prudp

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# Transport and stream IDs are servers/nex defaults and all are right for Minecraft:
# websocket transport, and NEX_SECURE_STREAM_ID=1, the two-listener shape (auth on 22310,
# secure on its own dialable 22311). That is what Minecraft's working server does (:443 auth,
# :60006 secure) and it matches the sid=1 in the station URL it hands out. Do NOT set
# NEX_SECURE_STREAM_ID=2; that is the single-listener shape only SMB35 uses.

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# Matchmaking and NEX unique IDs live here. The libraries create their own schemas
# (matchmaking, tracking, utility) on first run. Required; startup pings it.
MINECRAFT_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable
