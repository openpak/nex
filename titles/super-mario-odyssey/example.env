# super-mario-odyssey — example configuration. Copy to .env and fill in. Never commit a real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22340: authentication 22340, secure 22341, /healthz 22342. Two listeners.
NEX_PORT_BASE=22340

# Odyssey's NEX access key. Not a secret — it is a per-title constant derivable from the game's
# own binary — but it is configuration, so it lives here and never in source. This value is
# from the kinnay wiki Game Server List (server id 255BA201), reference-verified, NOT yet
# confirmed against Odyssey's own .rodata the way ARMS's key was. See docs/provenance.md.
NEX_ACCESS_KEY=afef0ecf

# The NEX library Odyssey links. UNCONFIRMED: the Game Server List records no per-title NEX
# version, so 4.0.0 is the best-precedented guess for the Oct-2017 (Splatoon 2/ACNH/MK8D) era.
# If LoginEx never completes on hardware, this is the first thing to change. docs/provenance.md.
NEX_VERSION=4.0.0

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# Transport and stream IDs are servers/nex defaults now, and every default is right for Odyssey:
#   NEX_TRANSPORT=websocket    — the OpenPak server serves both endpoints over WSS, no UDP.
#   NEX_SECURE_STREAM_ID=1     — the two-listener shape: auth on 22340, secure on its own
#                                dialable 22341, matching the OpenPak server's separate
#                                :8453 auth / :60013 secure and the sid=1 in its station URL.
#   NEX_SOURCE_KEY_BYTES=32    — the OpenPak server's source key is a 32-byte SHA-256.
#   NEX_STATION_SCHEME=prudps  — the Switch-era scheme the OpenPak server hands out.
#   NEX_SECURE_PID=2           — the OpenPak server's securePID.
# Do NOT set NEX_SECURE_STREAM_ID=2 here; that is the single-listener shape only SMB35 uses.

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
# Balloon World shows friends' balloons, so the friend graph is load-bearing here.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# DataStore metadata (the balloons) and the Utility NEX-unique-ID counter live here. The Utility
# library creates its own schema; datastore.go creates odyssey.
SMO_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable

# --- DataStore object bodies (the capture-pose screenshot + costume data) ---
# Leave SMO_S3_ENDPOINT empty and DataStore still serves every metadata call; only the three
# that move an object body answer Core::NotImplemented. Set it and all four do — which Balloon
# World needs, since a balloon is a screenshot. A half-configured store is a startup error.
SMO_S3_ENDPOINT=
SMO_S3_BUCKET=odyssey
SMO_S3_ACCESS_KEY=
SMO_S3_SECRET_KEY=
# 1 for a plain-HTTP store, e.g. a local MinIO on 23010.
SMO_S3_INSECURE=0
