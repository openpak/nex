# arms — example configuration. Copy to .env and fill in. Never commit a real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22140: authentication 22140, secure 22141, /healthz 22142. Two listeners.
NEX_PORT_BASE=22140

# ARMS's NEX access key. Not a secret — it is a per-title constant that comes out of the
# game's own binary — but it is configuration, so it lives here and never in source.
NEX_ACCESS_KEY=b6b34c51

# The NEX library ARMS links. The update links 4.3.5 and the update is what runs online;
# the base game links 4.0.3.
NEX_VERSION=4.3.5

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# Transport and stream IDs are servers/nex defaults now, and both defaults are right for ARMS:
# websocket transport, and NEX_SECURE_STREAM_ID=1, which is the two-listener shape -- auth on
# 22140, secure on its own dialable 22141. That is what ARMS's working OpenPak server does
# (:443 auth, :60006 secure) and it matches the sid=1 in the station URL it hands out. Do NOT
# set NEX_SECURE_STREAM_ID=2 here; that is the single-listener shape only SMB35 uses.

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# Matchmaking, NEX unique IDs and DataStore metadata all live here. The libraries create
# their own schemas (matchmaking, tracking, utility) and this repository creates arms.
ARMS_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable

# --- DataStore object bodies (optional) ---
# Leave ARMS_S3_ENDPOINT empty and DataStore still serves every metadata call; only the
# three that move an object body answer Core::NotImplemented. Set it and all four do.
ARMS_S3_ENDPOINT=
ARMS_S3_BUCKET=arms
ARMS_S3_ACCESS_KEY=
ARMS_S3_SECRET_KEY=
# 1 for a plain-HTTP store, e.g. a local MinIO on 23010.
ARMS_S3_INSECURE=0
