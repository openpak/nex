# animal-crossing-new-horizons — example configuration. Copy to .env and fill in. Never
# commit a real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22180: authentication 22180, secure 22181, /healthz 22182. Two listeners.
NEX_PORT_BASE=22180

# ACNH's NEX access key. Not a secret — it is a per-title constant that comes out of the
# game's own binary — but it is configuration, so it lives here and never in source. It is an
# 8-character string, NOT hex: do not "correct" it to hex, and do not confuse it with the
# Game Server ID 2EE2E300 (see docs/provenance.md, "The Game Server ID is not the access key").
NEX_ACCESS_KEY=v43a10em

# The NEX library ACNH links: 4.0.0 (integer form 40000).
NEX_VERSION=40000

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# Transport and stream IDs are servers/nex defaults now, and every default is right for ACNH:
# websocket transport; NEX_SECURE_STREAM_ID=1 (two-listener shape, auth on 22180, secure on
# its own dialable 22181, which matches ACNH's sid=1 station URL); NEX_STATION_SCHEME=prudps;
# NEX_SOURCE_KEY_BYTES=32 (ACNH derives a 32-byte source key). Do NOT set NEX_SECURE_STREAM_ID=2.

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# Matchmaking, NEX unique IDs and DataStore metadata all live here. The libraries create
# their own schemas (matchmaking, tracking, utility) and this repository creates acnh.
ACNH_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable

# --- DataStore object bodies (optional) ---
# Leave ACNH_S3_ENDPOINT empty and DataStore still serves every metadata call; only the
# three that move an object body answer Core::NotImplemented. Set it and all four do.
ACNH_S3_ENDPOINT=
ACNH_S3_BUCKET=acnh
ACNH_S3_ACCESS_KEY=
ACNH_S3_SECRET_KEY=
# 1 for a plain-HTTP store, e.g. a local MinIO on 23010.
ACNH_S3_INSECURE=0
