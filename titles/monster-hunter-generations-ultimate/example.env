# Copy to ".env" and fill in. No real secrets belong in this repository.

NEX_TITLE=mhgu
# ports.md block 22120: authentication 22120/tcp, secure 22121/udp, /healthz 22122.
NEX_PORT_BASE=22120
# The title's NEX access key. Configuration, not a secret: it is a constant of the game
# binary and the same for every server that hosts this title. See docs/provenance.md.
NEX_ACCESS_KEY=4152f312
# apiVersionGeneral. MHGU links NEX 4.4.0.
NEX_VERSION=40400
# MHGU is a hybrid, and this is the one setting nothing else in the fleet needs.
#
# Its authentication stage is a Switch stage: the console resolves
# g2896bd04-lp1.s.n.srv.nintendo.net and opens TLS on 443, which Traefik passes through by
# SNI to this title's auth port -- a TCP connection, so a UDP listener there is never
# reached. Its secure stage is the 3DS stage its NEX code was ported from: raw PRUDP over
# UDP, no TLS. docs/provenance.md carries the evidence for each half.
NEX_TRANSPORT=websocket
NEX_SECURE_TRANSPORT=udp
# Traefik passes the SNI through rather than terminating, so this server terminates TLS on
# the auth listener. Both must be set or neither.
NEX_TLS_CERT=
NEX_TLS_KEY=
NEX_SECURE_PID=2
# Address the console is told to dial for the secure server.
NEX_SECURE_HOST=127.0.0.1

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# Matchmaking, unique IDs and DataStore metadata (ports.md 23000).
DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/mhgu?sslmode=disable

# Object storage for DataStore bodies (ports.md 23010). Leave S3_ENDPOINT empty to run
# without it: metadata still works, object upload and download answer NotImplemented.
S3_ENDPOINT=127.0.0.1:23010
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mhgu
S3_USE_TLS=0
