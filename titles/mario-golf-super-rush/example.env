# Copy to .env and fill in. No real values belong in this repository.

NEX_TITLE=mario-golf-super-rush
# Block 22130 from ports.md. With the secure endpoint on its own stream (below) this is the
# only game port: one listener carries both endpoints, and +1 stays reserved but unbound.
NEX_PORT_BASE=22130
NEX_HTTP_ADDR=:22132
# Golf's NEX access key: 8 hex digits, confirmed, not derived from the game server ID in the
# DNS name. See docs/provenance.md.
NEX_ACCESS_KEY=1cb8027c
# An era guess, never measured for this title. Accepts 4.6.5 or the integer form 40605.
NEX_VERSION=4.6.5
# Address the console is told to reach the secure server on. A bare host or IP, no port.
NEX_SECURE_HOST=127.0.0.1

# --- The Switch shape. Both differ from the shared host's Wii U/3DS defaults, and both are
# --- set explicitly here because neither failure is visible in a healthy-looking server.
# A Switch NEX title speaks PRUDPLite over a WebSocket, never PRUDP over UDP.
NEX_TRANSPORT=websocket
# The secure endpoint gets its own stream, which is also what puts both endpoints on one
# listener: nex-go cannot bind two endpoints with the same stream ID to one server.
NEX_SECURE_STREAM_ID=2
# Whether the console treats the secure server as a Pia station. Never measured for Golf --
# see docs/design.md. The wrong value is not a clean failure.
NEX_STATION_SCHEME=prudps

# TLS. Golf's DNS name reaches us by Traefik SNI passthrough, so this server terminates:
# set both. Leave both empty only if Traefik terminates and forwards plain ws instead.
NEX_TLS_CERT=cert.pem
NEX_TLS_KEY=key.pem

# Matchmaking and NEX unique IDs. The tables are created on startup.
GOLF_DATABASE_URL=postgres://openpak@127.0.0.1:23000/openpak?sslmode=disable

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=
