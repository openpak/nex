# mario-strikers — example configuration. Copy to .env and fill in. Never commit a real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22300: authentication 22300, secure 22301, /healthz 22302. Two listeners.
NEX_PORT_BASE=22300

# Mario Strikers' NEX access key. Not a secret — it is a per-title constant that comes out of
# the game's own binary — but it is configuration, so it lives here and never in source. Note
# it is an 8-character ASCII string, not hex (the game server ID g26cfaf00... is NOT the key).
NEX_ACCESS_KEY=MAGNI5jG

# The NEX library Strikers links: 4.0.0 (40000). openpak/nex accepts either spelling.
NEX_VERSION=4.0.0

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# Transport and stream IDs are servers/nex defaults now, and every default is right for
# Strikers: websocket transport; NEX_SECURE_STREAM_ID=1, the two-listener shape (auth on
# 22300, secure on its own dialable 22301); prudps station scheme; secure PID 2; 32-byte
# source key. That matches the working OpenPak server (sid=1, stream=10, type=2, prudps,
# securePID=2, sha256 32-byte source key) field for field. Nothing here needs overriding.

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# Matchmaking, NEX unique IDs and DataStore metadata all live here. The libraries create
# their own schemas (matchmaking, tracking, utility) and this repository creates strikers.
STRIKERS_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable

# --- DataStore object bodies (optional) ---
# Strikers' observed online data (clubs, roster) travels over MatchmakeExtension, not
# DataStore; DataStore is registered so the game's 0x73 init calls get a real empty-store
# answer. Leave STRIKERS_S3_ENDPOINT empty and every metadata call still works; only the three
# that move an object body answer Core::NotImplemented. Set it and all four do.
STRIKERS_S3_ENDPOINT=
STRIKERS_S3_BUCKET=strikers
STRIKERS_S3_ACCESS_KEY=
STRIKERS_S3_SECRET_KEY=
# 1 for a plain-HTTP store, e.g. a local MinIO on 23010.
STRIKERS_S3_INSECURE=0
