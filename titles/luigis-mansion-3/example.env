# luigis-mansion-3 — example configuration. Copy to .env and fill in. Never commit a real .env.

# --- The NEX host (openpak/nex reads these; see servers/nex/README.md) ---
# ports.md block 22190: authentication 22190, secure 22191, /healthz 22192. Two listeners.
NEX_PORT_BASE=22190

# Luigi's Mansion 3's NEX access key. Not a secret — it is a per-title constant that comes out
# of the game's own binary — but it is configuration, so it lives here and never in source. A
# wrong one fails *silently*: the console retries forever and nothing is logged. This is NOT the
# game server ID (0x20DE2100); see docs/provenance.md.
NEX_ACCESS_KEY=aab95246

# The NEX library Luigi's Mansion 3 links: 4.0.0. Leave the rest unset — every other per-title
# fact (prudps station scheme, two-listener secure stream 1, 32-byte source key, websocket
# transport, secure PID 2) is defaulted correctly for this title by the server itself.
NEX_VERSION=4.0.0

# The address the console is told to dial for the secure endpoint. A bare host or IP.
NEX_SECURE_HOST=127.0.0.1

# nx-baas's internal game API — how a console becomes an OpenPak account and a friend list.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- State ---
# Matchmaking and NEX unique IDs both live here. The common libraries create their own schemas
# (matchmaking, tracking, utility) on first run. Required — without it the game has no lobbies.
LM3_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable
