# Copy to .env and fill in. No real values belong in this repository.

# --- Shared NEX host (platforms/wiiu-3ds/games/nex reads these) ---
NEX_TITLE=smb35
# This title's block from ports.md. Super Mario Bros. 35 puts both endpoints on ONE
# listener at +0 (see NEX_SECURE_STREAM_ID), so +1 is reserved and nothing listens on it.
# /healthz is on +2.
NEX_PORT_BASE=22160
# Super Mario Bros. 35's NEX access key. A public per-title value, not a secret, but it is
# configuration and does not belong in source.
NEX_ACCESS_KEY=
# The NEX library version the game was built against, as the console reports it.
NEX_VERSION=40600
# Address the console is told to reach the secure server on. Unused on this title: the
# secure station URL is a placeholder, because the console stays on the socket it has.
NEX_SECURE_HOST=127.0.0.1
NEX_STATION_SCHEME=prudps
# Secure endpoint on virtual port 2, which is what puts both endpoints on one listener.
# This is the shape Super Mario Bros. 35 expects; it is not the fleet default.
NEX_STREAM_ID=1
NEX_SECURE_STREAM_ID=2
# The secure server's principal ID at retail, not the conventional 2.
NEX_SECURE_PID=257049437023956657
# Source key length. 16 for this title: kinnay's server sends 16 and worked against a
# retail Super Mario Bros. 35 client. The host defaults to 32, which has same-title
# evidence behind it on other titles. Wrong here means a login that fails silently.
NEX_SOURCE_KEY_BYTES=16
NEX_HTTP_ADDR=:22162

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# --- This title ---
# Postgres. Matchmaking, messaging and the NEX unique-id table live here; the Pretendo
# common protocols create their own schemas on first start.
SMB35_DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/openpak?sslmode=disable

# Eagle relay. The gathering ID is appended as a path segment, so a lobby's session is
# <SMB35_EAGLE_URL>/<gid>. Leave empty until a relay exists: lobbies will form and no
# match will start.
SMB35_EAGLE_URL=
# HMAC-SHA256 key the relay verifies handoff tokens with, hex, 16 bytes or more. Shared
# with the relay and read by nothing else. Setting a URL without a key is refused.
SMB35_EAGLE_KEY=
