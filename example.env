# Copy to .env and fill in. No real credentials belong in this repository.

NEX_TITLE=mario-party-superstars

# The title's NEX access key. Configuration, not a secret: it is a property of the game and
# recoverable from it. e915510f is a confirmed measurement, not a guess -- brute-forced
# against a real captured PRUDP CONNECT signature. See docs/provenance.md.
NEX_ACCESS_KEY=e915510f

# NEX library version the game was built against, from its own SDK build string
# (apiVersionGeneral 40605). Changing this changes the login method and the wire encoding.
NEX_VERSION=4.6.5

# This title's block from ports.md: authentication 22110, secure 22111, /healthz 22112.
NEX_PORT_BASE=22110
NEX_HTTP_ADDR=:22112

# Wire shape, measured for this title -- see docs/provenance.md. Both are the code's own
# defaults; they are here to be read, not to be changed without a capture.
# prudps: the console hands over its kerberos ticket in CONNECT. Under prudp the handshake
# completes with an EMPTY CONNECT payload and the title dies when it needs the session.
NEX_STATION_SCHEME=prudps
# 1 = two listeners, secure on its own port at +1. This is a two-listener title; SMB35 is the
# one that wants 2. If nex-go ever logs "trying to connect to unbound PRUDPEndPoint 2", that
# is the signal this is wrong.
NEX_SECURE_STREAM_ID=1
# websocket is the host's default and correct here. Every Switch title speaks PRUDP over
# WebSocket; udp is the Wii U/3DS form.
NEX_TRANSPORT=websocket

# Address the console is told to reach the secure server on. Loopback only works for a
# loopback test; a console needs the host's real address.
NEX_SECURE_HOST=127.0.0.1

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# Postgres for matchmaking and NEX unique IDs. Required.
MPS_DATABASE_URL=postgres://openpak:@127.0.0.1:23000/mario_party_superstars?sslmode=disable

# Utility::GetIntegerSettings values, as "index:key=value" entries. Empty because this
# title's real values have never been captured -- see docs/provenance.md. Fill this in from
# a capture rather than editing the source.
MPS_INTEGER_SETTINGS=

# No DataStore settings: the protocol is not registered, because nothing has ever observed
# this title call it and the object store is shared, in servers/nex. See docs/design.md.
