# Copy to .env and fill in. No real values belong in this repository.

# This title's block from ports.md: authentication +0, secure +1, /healthz +2.
NEX_PORT_BASE=22150
# Mario Kart 8 Deluxe's NEX access key. Per title, derivable from the game, not a secret --
# but still configuration, so it is not compiled in.
NEX_ACCESS_KEY=
# nx-baas game/internal API and its NX_INTERNAL_KEY. Without the key every login is refused.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=
# Postgres. Matchmaking, utility and ranking create their schemas here on first run.
MK8D_DATABASE_URL=postgres://openpak:@127.0.0.1:23000/openpak?sslmode=disable

# Address the console is told to reach the secure server on.
NEX_SECURE_HOST=127.0.0.1

# The per-title defaults below are already what cmd/mk8d uses. Set them only to override.
# NEX_VERSION=4.0.0            # MK8D reports 4.0.0; this picks login method 2
# NEX_TRANSPORT=websocket      # a Switch never speaks PRUDP over UDP
# NEX_STATION_SCHEME=prudp     # MK8D's secure station scheme
# NEX_SECURE_STREAM_ID=1       # 2 collapses both endpoints onto the +0 listener
# NEX_SECURE_PID=2
# NEX_TITLE=mario-kart-8-deluxe
# NEX_HTTP_ADDR=:22152
