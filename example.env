# Copy to .env and fill in. No real values belong in this repository.

NEX_TITLE=nex
# The title's block from ports.md: a multiple of ten in 22100-22199 or 22300-22599.
# Authentication listens on +0, secure on +1, /healthz on +2.
NEX_PORT_BASE=22100
# The title's NEX access key. Per title; comes from the game, not from us.
NEX_ACCESS_KEY=
# NEX library version the title was built against. "4.6.5" or the integer form the console
# reports as apiVersionGeneral, 40605. Switch titles observed so far span 4.0.0 to 4.6.5.
NEX_VERSION=4.4.0
# Address the console is told to reach the secure server on.
NEX_SECURE_HOST=127.0.0.1
# prudps or prudp, per title. Getting it wrong is not a clean failure: menus keep working and
# the title gives up later, when it actually needs the session.
NEX_STATION_SCHEME=prudps
# websocket (default) or udp. Every Switch title speaks PRUDP over WebSocket, which is why it
# is the default; udp is the Wii U/3DS form. Choosing websocket also selects PRUDP Lite --
# in nex-go they are one switch.
NEX_TRANSPORT=websocket
# Terminate TLS here (Traefik SNI passthrough) by setting both; leave both empty to let the
# front proxy terminate and forward plain ws. Exactly one set is refused at startup.
NEX_TLS_CERT=
NEX_TLS_KEY=
# PRUDP virtual ports. Setting the secure one different (e.g. 2) puts both endpoints on ONE
# listener at +0 and leaves +1 reserved. This is per title and has no safe default -- working
# servers exist for both shapes, so set it from what your title is known to do. If a console
# reaches you and nex-go logs "trying to connect to unbound PRUDPEndPoint 2", set it to 2.
NEX_STREAM_ID=1
NEX_SECURE_STREAM_ID=1
# Length of the kerberos source key handed to the console. Per title and silent when wrong:
# 32 is attested by a live MK8D server, 16 by a reference server working against a retail
# SMB35. If a console refuses a ticket with nothing logged, flip this first.
NEX_SOURCE_KEY_BYTES=32
# Secure server principal ID: kerberos ticket target and station URL PID. Some titles have a
# retail-observed constant instead of the conventional 2.
NEX_SECURE_PID=2
# /healthz listener. Defaults to :<NEX_PORT_BASE+2>.
NEX_HTTP_ADDR=:22102

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=
