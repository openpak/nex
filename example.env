# Copy to ".env" and fill in. No real secrets belong in this repository.

NEX_TITLE=mhgu
# ports.md block 22120: authentication 22120/udp, secure 22121/udp, /healthz 22122.
NEX_PORT_BASE=22120
# The title's NEX access key. Configuration, not a secret: it is a constant of the game
# binary and the same for every server that hosts this title. See docs/provenance.md.
NEX_ACCESS_KEY=4152f312
# apiVersionGeneral. MHGU links NEX 4.4.0.
NEX_VERSION=40400
# MHGU is a 3DS-lineage title: raw PRUDP over UDP, not the WebSocket transport native
# Switch titles use. Both of these are the servers/nex defaults, set here to be explicit.
NEX_TRANSPORT=udp
NEX_SECURE_PID=2
# Address the console is told to dial for the secure server.
NEX_SECURE_HOST=127.0.0.1

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# Matchmaking, unique IDs and DataStore metadata (ports.md 23000).
DATABASE_URL=postgres://openpak:openpak@127.0.0.1:23000/mhgu?sslmode=disable

# Object storage for DataStore bodies (ports.md 23010). Leave S3_ENDPOINT empty to run
# without it: metadata still works, object upload and download answer NotImplemented.
S3_ENDPOINT=127.0.0.1:23010
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mhgu
S3_USE_TLS=0
