# Copy to .env and fill in. No real values belong in this repository.

NEX_TITLE=nex
# The title's block from ports.md: a multiple of ten in 22100-22199 or 22300-22599.
# Authentication listens on +0, secure on +1, /healthz on +2.
NEX_PORT_BASE=22100
# The title's NEX access key. Per title; comes from the game, not from us.
NEX_ACCESS_KEY=
# NEX library version the title was built against. "4.6.5" or the integer form the console
# reports as apiVersionGeneral, 40605. Switch titles observed so far span 4.0.0 to 4.6.5.
NEX_VERSION=4.4.0
# Address the console is told to reach the secure server on.
NEX_SECURE_HOST=127.0.0.1
# prudps or prudp, per title. Getting it wrong is not a clean failure: menus keep working and
# the title gives up later, when it actually needs the session.
NEX_STATION_SCHEME=prudps
# PRUDP virtual port both endpoints bind. 1 unless a title is seen targeting another.
NEX_STREAM_ID=1
# /healthz listener. Defaults to :<NEX_PORT_BASE+2>.
NEX_HTTP_ADDR=:22102

# nx-baas game/internal API (ports.md 20070) and its NX_INTERNAL_KEY.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=
