# Copy to .env and fill in. No real secrets belong in this repository.

# Postgres. The server creates its own schemas at startup.
DATABASE_URL=postgres://openpak:CHANGE_ME@127.0.0.1:23000/openpak?sslmode=disable

# This title's block from ports.md: auth 22330, secure 22331, /healthz 22332.
NEX_PORT_BASE=22330

# The title's NEX access key. Public and documented per title (Kinnay's Game Server List),
# recorded on the OpenPak server. Configuration rather than a literal in source.
NEX_ACCESS_KEY=fdf6617f

# NEX library version. The OpenPak server built this title against 4.0.0 (integer 40000);
# a GUESS carried across until a console capture settles it -- see docs/provenance.md.
NEX_VERSION=4.0.0

# Two listeners with the secure endpoint on its own port, which is this title's shape
# (OpenPak's station URL carries sid=1 and the auth/secure ports are distinct). Both
# stream IDs stay 1; setting the secure one to 2 would collapse them onto one listener.
NEX_STREAM_ID=1
NEX_SECURE_STREAM_ID=1
NEX_STATION_SCHEME=prudps
NEX_SECURE_PID=2

# Source key length. 32 bytes: the Switch kerberos key size, which the OpenPak server
# says in as many words a 16-byte key makes the console reject the ticket. Default is 32.
NEX_SOURCE_KEY_BYTES=32

# Address the console is told to reach the secure endpoint on.
NEX_SECURE_HOST=127.0.0.1

# Set both to terminate wss here (Traefik passing SNI through), or neither to let Traefik
# terminate and forward plain ws.
NEX_TLS_CERT=
NEX_TLS_KEY=

# nx-baas game API (ports.md 20070) and its internal key.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=

# Object bucket for DataStore object bodies. UNLIKE most titles, SMM2 genuinely uploads
# object bodies -- a course's level BLOB -- so a real bucket is needed for course
# upload/download to work. Leave unset only for a metadata-only bring-up.
DATASTORE_S3_ENDPOINT=
DATASTORE_S3_ACCESS_KEY=
DATASTORE_S3_SECRET_KEY=
DATASTORE_S3_BUCKET=
DATASTORE_S3_INSECURE=
